# Copy to .env. Only listens on this machine.
PERSONA_PORT=8030
PERSONA_DATABASE_URL=sqlite+aiosqlite:///data/anima.db
# token=namespace pairs; the Godot client uses the "anima" namespace
PERSONA_SERVICE_TOKENS=anima-local-token=anima
# openai: your own key (fill it here or on the pet's settings page); fake: offline test stand-in
PERSONA_MODEL_BACKEND=openai
PERSONA_OPENAI_API_KEY=
PERSONA_OPENAI_BASE_URL=
PERSONA_MODEL=
# model calls go direct (system/shell proxies ignored); set only if the service needs a proxy
PERSONA_MODEL_PROXY=
# 桌宠聊天闲置多少分钟后结束这段对话、整理成记忆
PERSONA_CHAT_IDLE_MINUTES=10
PERSONA_MAX_PERSONAS=5
# DeepSeek V4 (TokenHub) needs thinking off; other services may reject the parameter
PERSONA_DISABLE_THINKING=true
# saved by the pet's settings page; overrides the model settings above
PERSONA_MODEL_FILE=data/model.json